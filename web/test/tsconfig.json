{
  // Type-checks unit + e2e tests (referenced from ../tsconfig.json, so
  // `pnpm typecheck` covers them). Tests import app modules explicitly.
  "extends": "../.nuxt/tsconfig.app.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // Keep the incremental build info out of the source tree.
    "tsBuildInfoFile": "../.nuxt/tsconfig.test.tsbuildinfo"
  },
  "include": ["./**/*.ts", "../app/types/**/*.ts", "../app/utils/**/*.ts", "../app/stores/**/*.ts", "../.nuxt/nuxt.d.ts"],
  "exclude": []
}
