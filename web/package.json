{
  "name": "gos3-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "gos3 web UI (Nuxt 4) — manage one or more S3 servers, embedded in gos3 or standalone",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "generate:embed": "NUXT_APP_BASE_URL=/_gos3/ui/ NUXT_PUBLIC_EMBEDDED=true nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:real": "E2E_REAL_ONLY=1 playwright test --project=real-server",
    "test:e2e:standalone": "E2E_REAL_ONLY=1 playwright test --project=standalone",
    "screenshots": "E2E_REAL_ONLY=1 playwright test --project=screenshots"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@nuxt/ui": "^4.11.3",
    "@pinia/nuxt": "^1.0.2",
    "aws4fetch": "^1.0.20",
    "multicast-dns": "^7.2.5",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.6.3",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
