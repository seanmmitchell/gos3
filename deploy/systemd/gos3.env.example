# /etc/gos3/gos3.env — environment for gos3.service (install with mode 0600).
# Every configuration key has a GOS3_* variable; `gos3 config env` lists them.

# Root credentials (access key 3-128 of [A-Za-z0-9._-], secret 8-128 printable
# characters). Generate a pair with `gos3 keygen`. If both are left unset,
# gos3 generates a pair on first start, logs it once (journalctl -u gos3) and
# stores it in /var/lib/gos3/.gos3/root-credentials.json.
#GOS3_ROOT_ACCESS_KEY=
#GOS3_ROOT_SECRET_KEY=

# Optional YAML configuration (create it with `gos3 config init -o /etc/gos3/config.yaml`,
# then chmod 0644; keep secrets in this file instead).
#GOS3_CONFIG=/etc/gos3/config.yaml

#GOS3_NAME=nas
#GOS3_REGION=us-east-1
#GOS3_PUBLIC_URL=https://s3.example.com
#GOS3_DOMAINS=s3.example.com
# TLS: the certificate must be readable by the dynamic service user (0644).
# The private key normally is not (0600), so pass it as a credential in a
# drop-in (`systemctl edit gos3`) instead of setting GOS3_TLS_KEY here
# (%d is not expanded in this file):
#   [Service]
#   LoadCredential=tls.key:/etc/ssl/private/gos3.key
#   Environment=GOS3_TLS_KEY=%d/tls.key
#GOS3_TLS_CERT=/etc/gos3/tls.crt
# Behind a reverse proxy: honour X-Forwarded-For / X-Forwarded-Proto, only
# from these proxy addresses (CIDRs or IPs, comma-separated).
#GOS3_TRUST_PROXY_HEADERS=false
#GOS3_SERVER_TRUSTED_PROXIES=127.0.0.1,::1
#GOS3_LOG_FORMAT=json
