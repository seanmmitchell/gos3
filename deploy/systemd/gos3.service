# gos3 systemd unit (hardened).
#
# Install:
#   install -m 0755 gos3 /usr/local/bin/gos3
#   install -m 0644 deploy/systemd/gos3.service /etc/systemd/system/gos3.service
#   install -d -m 0755 /etc/gos3
#   install -m 0600 deploy/systemd/gos3.env.example /etc/gos3/gos3.env   # edit it
#   systemctl daemon-reload && systemctl enable --now gos3
#   journalctl -u gos3        # startup banner; generated root keys if none are set
#
# Data and system state (iam.json, settings.json, root-credentials.json,
# server-id) live in /var/lib/gos3, owned by a dynamic service user. The
# environment file is read by systemd as root, so it may hold the root keys
# with mode 0600. A YAML config (GOS3_CONFIG=/etc/gos3/config.yaml) is read
# by the service user: keep it free of secrets and world-readable (0644).
# The same goes for a TLS certificate; pass the TLS private key with
# LoadCredential= (see gos3.env.example and docs/deployment.md).

[Unit]
Description=gos3 S3-compatible object storage server
Documentation=https://github.com/seanmmitchell/gos3
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gos3 serve
Environment=GOS3_DATA=/var/lib/gos3
Environment=GOS3_ADDRESS=:9000
EnvironmentFile=-/etc/gos3/gos3.env
# SIGTERM triggers a graceful shutdown (server.shutdown_timeout, default 30s).
KillSignal=SIGTERM
TimeoutStopSec=45s
Restart=on-failure
RestartSec=2s
LimitNOFILE=65536

# Identity and state
DynamicUser=yes
StateDirectory=gos3
StateDirectoryMode=0700
ConfigurationDirectory=gos3
ConfigurationDirectoryMode=0755
UMask=0077
WorkingDirectory=/var/lib/gos3

# Hardening
NoNewPrivileges=yes
# No capabilities: the default port 9000 is unprivileged. To listen on 80/443
# directly, set CapabilityBoundingSet=CAP_NET_BIND_SERVICE and
# AmbientCapabilities=CAP_NET_BIND_SERVICE (or use a reverse proxy).
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# AF_NETLINK lets discovery enumerate interfaces for mDNS / the multicast beacon.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
